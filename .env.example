# Copy to .env for local development. Real environment variables win over this file.

# Shop
SHOP_NAME=Setec Shop
SECRET_KEY=change-me-to-a-long-random-string

# Database: leave empty to use SQLite (instance/shop.db). On Render, set your PostgreSQL URL.
DATABASE_URL=

# Admin account created on first start (only if no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# KHQR / Bakong
BAKONG_ACCOUNT_ID=yourname@aclb
# ABA only: your ABA account number (digits) and bank name. Leave empty for other banks.
BAKONG_ACCOUNT_INFO=
BAKONG_ACQUIRING_BANK=
# ABA and other banks with a shared Bakong ID: paste your own "Receive money" KHQR text here instead.
# It replaces the three settings above. Scan your bank QR with any QR reader to get the text (starts with 000201).
BAKONG_KHQR_TEMPLATE=
MERCHANT_NAME=Setec Shop
MERCHANT_CITY=Phnom Penh
# Leave empty for demo mode (a "Simulate payment" button confirms the order).
# Set a Bakong developer token (https://api-bakong.nbc.gov.kh) to detect real payments.
BAKONG_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
# How long a KHQR code stays valid, in minutes
PAYMENT_TIMEOUT_MINUTES=15
